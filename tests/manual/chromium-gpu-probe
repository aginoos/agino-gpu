#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# chromium-gpu-probe [--offload] PROGRAM [ARGS...]
# Starts a Chromium-based program (browser or Electron app) in the current X session with a DevTools
# port, prints what Chromium itself reports about its GPU (SystemInfo.getInfo: renderer, ANGLE backend,
# feature status), whether ANGLE failed with "Invalid visual ID requested", the dGPU runtime PM state and
# the --use-angle/--*-features switches the GPU process got, then closes the program. --offload adds the
# variables of /run/agino-gpu/offload.env (design.md 5.1). Used for the 5.4.1 measurements; run by hand.
set -u
offload=
[ "${1:-}" = --offload ] && { offload=1; shift; }
[ $# -ge 1 ] || { echo "usage: $0 [--offload] PROGRAM [ARGS...]" >&2; exit 2; }
here=$(dirname "$(readlink -f "$0")")
. "$here/chromium-lib.sh"
port=${CHROMIUM_GPU_PROBE_PORT:-9341}
log=$(mktemp)
envs=
[ -n "$offload" ] && envs=$(grep -v '^#' /run/agino-gpu/offload.env | tr '\n' ' ')

# shellcheck disable=SC2086 # envs is a list of KEY=VALUE words
start_program "$log" env $envs "$@"
sleep 4
echo "program: $* ${offload:+(offload)}"
python3 -I "$here/cdp-gpuinfo.py" "$port" || true
echo "invalid-visual: $(grep -c 'Invalid visual' "$log")  dgpu: $(cat "$(dgpu_pm)" 2>/dev/null || echo none)"
for p in $(gpu_pids); do
    echo "gpu process: $(tr '\0' '\n' <"/proc/$p/cmdline" | grep -E -- '^--?(use-angle|enable-features|disable-features)=' | tr '\n' ' ')"
done
# Close the program and report how long the dGPU takes to go back to runtime suspend.
close_program
dgpu_settle
rm -f "$log"
