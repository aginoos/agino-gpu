// Members of sudo in the active local session switch the graphics mode, and see every process
// that uses the discrete GPU, without a password (same rule as agino's D-57 rules). Everyone
// else falls through to the defaults in org.agino.gpu.policy.
polkit.addRule(function (action, subject) {
    if ((action.id == "org.agino.gpu.set-mode" ||
         action.id == "org.agino.gpu.list-all-users") &&
        subject.local && subject.active && subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
