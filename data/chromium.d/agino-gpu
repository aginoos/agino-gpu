# Sourced by Debian's /usr/bin/chromium wrapper (after it has reset CHROMIUM_FLAGS, so an
# environment variable cannot carry the switches). On X11 with NVIDIA PRIME render offload
# (agino-gpu-run, the launcher and dock menus, "always use the discrete GPU" rules) Chromium's
# default ANGLE-GL backend fails ("Invalid visual ID requested") and falls back to software
# rendering; ANGLE on Vulkan renders on the NVIDIA GPU (design.md §5.4, V-5). A --use-angle=
# already in CHROMIUM_FLAGS or on the command line ("$@" is the wrapper's: the user's own switch,
# or the ones agino-gpu-run and the DAM patch insert) is kept and nothing is added.

if [ "${__NV_PRIME_RENDER_OFFLOAD:-}" = 1 ]; then
    case " ${CHROMIUM_FLAGS:-} $* " in
    *" --use-angle="*) ;;
    *)
        CHROMIUM_FLAGS="${CHROMIUM_FLAGS:+$CHROMIUM_FLAGS }--use-angle=vulkan --enable-features=Vulkan,VulkanFromANGLE,DefaultANGLEVulkan"
        ;;
    esac
fi
