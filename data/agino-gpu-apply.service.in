[Unit]
Description=Apply the saved agino GPU mode for this boot
# After coldplug: the PCI devices and asus-nb-wmi (gpu_mux_mode, dgpu_disable) must be visible.
After=systemd-udevd.service systemd-udev-trigger.service systemd-modules-load.service
Before=display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@AGINO_GPU_LIBEXECDIR@/agino-gpu-apply
TimeoutStartSec=30

[Install]
# graphical.target pulls in display-manager.service; Before= above orders us ahead of it.
WantedBy=graphical.target
